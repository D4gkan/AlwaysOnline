# Copy this file to `.env` and fill in real values.
# NEVER commit your actual .env file.

# --- Discord ---
# Required: webhook used for all outbound alerts.
DISCORD_WEBHOOK_URL=

# Optional: only needed if you want the /status slash command bot.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: restrict slash-command sync to one guild for instant registration.
DISCORD_GUILD_ID=

# --- Monitoring cadence (seconds) ---
HEALTH_CHECK_INTERVAL_SEC=300
LIGHT_ACTIVITY_MIN_SEC=300
LIGHT_ACTIVITY_MAX_SEC=900
REFRESH_INTERVAL_SEC=1800
RETRY_ATTEMPTS=2
RETRY_BACKOFF_SEC=15

# --- Browser ---
# Keep HEADLESS=false; use a visible browser (Xvfb on headless servers).
HEADLESS=false
USE_XVFB=false
BROWSER_ZOOM_PERCENT=60
WINDOW_WIDTH=256
WINDOW_HEIGHT=256

# --- Logging ---
LOG_RETENTION_DAYS=7
